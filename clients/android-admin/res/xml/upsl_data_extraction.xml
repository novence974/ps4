<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusions for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="upsl_admin.xml" />
        <exclude domain="sharedpref" path="upsl_transfers.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="upsl_admin.xml" />
        <exclude domain="sharedpref" path="upsl_transfers.xml" />
    </device-transfer>
</data-extraction-rules>
