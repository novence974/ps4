<?xml version="1.0" encoding="utf-8"?>
<!-- ULTIMATE PS LIBRARY admin app: colours and themes (same palette as the website's dark theme). -->
<resources>
    <color name="upsl_bg">#FF070816</color>
    <color name="upsl_bg2">#FF12113A</color>
    <color name="upsl_ink">#FFE8EBFF</color>
    <color name="upsl_mist">#FF9AA3C7</color>
    <color name="upsl_faint">#FF6B7399</color>
    <color name="upsl_accent">#FF8B7CFF</color>
    <color name="upsl_accent2">#FF5AA9FF</color>
    <color name="upsl_accent3">#FF5EE6F0</color>

    <style name="UpslTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/upsl_bg</item>
        <item name="android:colorBackground">@color/upsl_bg</item>
        <item name="android:colorPrimary">@color/upsl_bg2</item>
        <item name="android:colorPrimaryDark">@color/upsl_bg</item>
        <item name="android:colorAccent">@color/upsl_accent</item>
        <item name="android:colorControlNormal">@color/upsl_mist</item>
        <item name="android:colorControlActivated">@color/upsl_accent</item>
        <item name="android:colorControlHighlight">#338B7CFF</item>
        <item name="android:textColorPrimary">@color/upsl_ink</item>
        <item name="android:textColorSecondary">@color/upsl_mist</item>
        <item name="android:textColorHint">@color/upsl_faint</item>
        <item name="android:statusBarColor">@color/upsl_bg</item>
        <item name="android:navigationBarColor">@color/upsl_bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:alertDialogTheme">@style/UpslDialog</item>
    </style>

    <style name="UpslDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/upsl_accent</item>
        <item name="android:colorBackground">#FF151A3A</item>
        <item name="android:textColorPrimary">@color/upsl_ink</item>
        <item name="android:textColorSecondary">@color/upsl_mist</item>
        <item name="android:colorControlActivated">@color/upsl_accent</item>
    </style>
</resources>
